<?xml version="1.0" encoding="utf-8"?>
<!-- Slot picker selected-item view: explicit theme text color so the label
     stays readable in every theme (the stock simple_spinner_item relies on
     the platform default, which is wrong under the dark themes here). -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="marquee"
    android:singleLine="true"
    android:textColor="?attr/themeTextPrimary"
    android:textSize="14sp"
    android:fontFamily="sans-serif-medium" />
