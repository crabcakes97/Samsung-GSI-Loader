<?xml version="1.0" encoding="utf-8"?>
<!-- 5.9.6 skin: section card. Surface fill, tighter radius than the old
     24dp cards, plus a hairline outline so cards read as cards on every
     theme (all colors come from theme attrs, so all 8 themes adapt). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/themeSurface" />
    <stroke android:width="1dp" android:color="?attr/themeOutlineVariant" />
    <corners android:radius="20dp" />
</shape>
