<?xml version="1.0" encoding="utf-8"?>
<!-- 5.9.6 skin: tonal button with a hairline outline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeSurfaceHighest" />
            <stroke android:width="1dp" android:color="?attr/themeOutlineVariant" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
